# run `npx auth secret`
AUTH_SECRET=

# Legacy auth API this tool logs in against to obtain an access token.
AUTH_API_BASE_URL=http://localhost:8000/api
AUTH_API_TENANT=rmhcsc # X-Tenant header

# sc-workflow-engine backend that gets seeded.
WORKFLOW_ENGINE_API_BASE_URL=http://localhost:8086
NEXT_PUBLIC_WORKFLOW_ENGINE_DEFAULT_HOUSE_ID=<House UUID> # X-House header
